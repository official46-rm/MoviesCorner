{
  "name": "RudraMoviezBot",
  "description": "Rudra Moviez Telegram search and auto-filter bot. Configure secrets as environment variables.",
  "stack": "container",
  "keywords": [
    "telegram",
    "auto-filter",
    "movie-search",
    "pyrogram",
    "media",
    "search"
  ],
  "website": "https://github.com/official46-rm/MoviesCorner",
  "repository": "https://github.com/official46-rm/MoviesCorner",
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from BotFather. Keep private.",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API hash from my.telegram.org. Keep private.",
      "required": true
    },
    "ADMINS": {
      "description": "Telegram numeric user ID(s), space-separated.",
      "required": true
    },
    "CHANNELS": {
      "description": "Source channel ID(s) for media you are authorized to index; space-separated.",
      "required": false
    },
    "LOG_CHANNEL": {
      "description": "Private log channel ID; add the bot as admin.",
      "required": true
    },
    "DATABASE_URI": {
      "description": "MongoDB connection URI. Keep private.",
      "required": true
    },
    "DATABASE_NAME": {
      "description": "MongoDB database name.",
      "value": "RudraMoviez",
      "required": false
    },
    "COLLECTION_NAME": {
      "description": "MongoDB collection name.",
      "value": "RudraMoviez_files",
      "required": false
    },
    "SUPPORT_CHAT": {
      "description": "Support group username without @.",
      "value": "RudraMoviez",
      "required": false
    },
    "AUTH_CHANNEL": {
      "description": "Optional force-subscribe channel ID.",
      "required": false
    }
  },
  "addons": [],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "free"
    }
  }
}
